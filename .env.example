# Copy this file to .env and fill only the variables you need.
# Do not commit your filled .env file.

# Vertex AI / Google GenAI settings
PROJECT_ID=your-google-cloud-project-id
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-2.5-pro
MODEL_NAME=gemini-3-flash-preview
GEMINI_MAX_OUTPUT_TOKENS=4096

# Gemini API key for the research agent, if not using Vertex for that step
GEMINI_API_KEY=your-api-key-here
# GOOGLE_API_KEY=your-api-key-here

# Job posting / hiring report pipeline
COMPANIES_ROOT=job_postings/pre_processed
PIPELINE_DEPS_DIR=./_pydeps_vertex_pipeline
BATCH_SIZE=100
MAX_WORKERS=6
MAX_RETRIES=5
MAX_CALLS_PER_MINUTE=60
SLEEP_BETWEEN_BATCHES=2
SLEEP_BETWEEN_COMPANIES=0
RUN_ANALYSIS=true

# Local RAG settings
DATA_DIR=rag/data
INDEX_DIR=rag/index
EMBEDDING_MODEL=intfloat/multilingual-e5-small
CHUNK_SIZE_WORDS=420
CHUNK_OVERLAP_WORDS=80
TOP_K=8
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
